# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 48
PCE_SECRET_KEY=
# Firm id for the break-glass admin; use the same value with "feelens.sh users create --tenant".
PCE_ADMIN_TENANT=safe-capital
# Break-glass admin, for emergencies only. Leave the three lines empty once personal admins exist.
PCE_ADMIN_USERNAME=
PCE_ADMIN_PASSWORD=
PCE_ADMIN_TOTP_SECRET=
# Days without activity after which a prospect who did not become a client is erased.
PCE_RETENTION_DAYS=90
# Name analysts type in the browser (see Caddyfile).
FEELENS_HOST=localhost
# age public key that encrypts backups (age-keygen); the private key stays offline, never on this machine.
BACKUP_RECIPIENT=
