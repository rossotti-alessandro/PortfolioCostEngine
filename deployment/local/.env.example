# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 48
PCE_SECRET_KEY=
# Key that seals the activity log (tamper check). Generate once, never change, keep a copy offline.
PCE_AUDIT_KEY=
# Firm id of everyone the admin adds.
PCE_ADMIN_TENANT=safe-capital
# Setup admin: adds the named people in Team & access. Empty the three lines once a named person has the
# admin role, and fill them again only in an emergency. TOTP secret: see docs/app/PILOT_INSTALL.md step 3.
PCE_ADMIN_USERNAME=
PCE_ADMIN_PASSWORD=
PCE_ADMIN_TOTP_SECRET=
# Days without activity after which a prospect who did not become a client is erased.
PCE_RETENTION_DAYS=90
# Name analysts type in the browser (see Caddyfile).
FEELENS_HOST=localhost
# age public key that encrypts backups (age-keygen); the private key stays offline, never on this machine.
BACKUP_RECIPIENT=
