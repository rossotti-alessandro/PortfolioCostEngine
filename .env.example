# Copy to .env (gitignored). Never commit real values.

# Where the backend stores uploaded documents and the SQLite database (outside the repo by default).
PCE_DATA_DIR=./var
PCE_DATABASE_URL=sqlite:///./var/pce.sqlite3

# Privacy switch (docs/adr/0004). Off by default: no client content leaves the machine.
# Turning this on requires a recorded compliance decision for the organisation.
PCE_ALLOW_EXTERNAL_AI=false
# Only used when PCE_ALLOW_EXTERNAL_AI=true, on redacted page regions.
ANTHROPIC_API_KEY=

# Public product-document lookup (KID/factsheet). ISINs only, never quantities or values.
PCE_ALLOW_PUBLIC_LOOKUP=true
OPENFIGI_API_KEY=

# Upload guards
PCE_MAX_UPLOAD_MB=50
PCE_MAX_PDF_PAGES=500

# Frontend
VITE_API_BASE_URL=http://localhost:8000
